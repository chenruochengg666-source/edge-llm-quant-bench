# 忽略前端和 IDE 依赖 / 缓存
node_modules/
.hvigor/
.idea/
.vscode/
__pycache__/
*.pyc

# 忽略大模型文件
*.gguf
*.safetensors
*.bin
*.kld

# 忽略系统文件
.DS_Store
Thumbs.db

# 忽略 Office 临时文件与中间件
~$*
*.tmp

# 忽略本地备份文件
*.bak
*.bak_*

# 忽略 Python 环境与工具缓存
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# 忽略脚本运行的临时产物
*.log
*.out
*.err

# 忽略 OS / 编辑器杂项
*.swp
*~
desktop.ini

# 忽略中间结果目录（如需保留，删除本行）
